// Fragment Shader

layout(binding = 0) uniform sampler2D image;
layout(binding = 1) uniform sampler2D preblurImage;
uniform float2 u_iResolution;
uniform float2 u_startPoint;
uniform float2 u_endPoint;
uniform float u_softness;
uniform float u_invert;
uniform float u_blurMix;

float4 sampleImage(in float2 coord) {
    return texture(image, coord / u_iResolution);
}

float4 samplePreblurImage(in float2 coord) {
    return texture(preblurImage, coord / u_iResolution);
}

half4 main(float2 fragCoord) {
    float4 outColor;
    float2 startCoord = u_startPoint * u_iResolution;
    float2 endCoord = u_endPoint * u_iResolution;
    float2 axis = endCoord - startCoord;
    float axisLengthSquared = max(dot(axis, axis), 1e-05);
    float projected = dot(fragCoord - startCoord, axis) / axisLengthSquared;
    float edge0 = -u_softness;
    float edge1 = 1.0 + u_softness;
    float gradient = smoothstep(edge0, edge1, projected);
    if (u_invert > 0.5) {
        gradient = 1.0 - gradient;
    }
    float mixAmount = clamp(gradient * u_blurMix, 0.0, 1.0);
    float4 sourceColor = sampleImage(fragCoord);
    float4 blurColor = samplePreblurImage(fragCoord);
    outColor = mix(sourceColor, blurColor, mixAmount);
    return half4(outColor);
}


