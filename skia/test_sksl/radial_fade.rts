uniform float2 resolution;
uniform float time;

half4 main(float2 xy) {
    float2 uv = (xy / max(resolution, float2(1.0))) * 2.0 - 1.0;
    float radius = length(uv);
    float pulse = 0.5 + 0.5 * sin(time + radius * 16.0);
    float alpha = smoothstep(1.1, 0.15, radius);

    half3 inner = half3(0.15, 0.65, 1.00);
    half3 outer = half3(0.02, 0.04, 0.10);
    half3 rgb = mix(outer, inner, half(pulse * alpha));
    return half4(rgb, half(alpha));
}
