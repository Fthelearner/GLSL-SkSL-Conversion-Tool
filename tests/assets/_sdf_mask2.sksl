
uniform vec2 iResolution;

float sdCircle(vec2 p, float r) { return length(p) - r; }
float sdRoundedBox(vec2 p, vec2 b, float cr) {
    vec2 q = abs(p) - b + cr;
    return length(max(q, 0.0)) - cr + min(max(q.x, q.y), 0.0);
}

half4 main(vec2 fragCoord) {
    vec2 p = fragCoord.xy;
    
    // Multiple shapes scattered around
    float d = sdCircle(p - vec2(200.0, 200.0), 60.0);       // top-left circle
    d = min(d, sdCircle(p - vec2(1000.0, 180.0), 45.0));     // top-right circle
    d = min(d, sdRoundedBox(p - vec2(350.0, 520.0), vec2(80.0, 50.0), 20.0)); // left rounded rect
    d = min(d, sdCircle(p - vec2(880.0, 500.0), 55.0));      // right circle
    d = min(d, sdRoundedBox(p - vec2(640.0, 360.0), vec2(120.0, 90.0), 30.0)); // center rounded rect
    d = min(d, sdCircle(p - vec2(180.0, 100.0), 35.0));      // small circle
    
    float alpha = d < 0.0 ? 1.0 : 0.0;
    return half4(alpha, 0.0, 0.0, alpha);
}
