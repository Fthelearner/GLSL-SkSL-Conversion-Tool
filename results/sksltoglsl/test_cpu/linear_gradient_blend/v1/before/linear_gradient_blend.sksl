uniform shader image;
uniform shader preblurImage;
uniform float2 iResolution;
uniform float2 startPoint;
uniform float2 endPoint;
uniform float softness;
uniform float invert;
uniform float blurMix;

half4 main(float2 fragCoord)
{
    float2 start_coord = startPoint * iResolution;
    float2 end_coord = endPoint * iResolution;
    float2 axis = end_coord - start_coord;
    float axis_length_squared = max(dot(axis, axis), 1e-5);
    float projected = dot(fragCoord - start_coord, axis) / axis_length_squared;

    float edge0 = 0.0 - softness;
    float edge1 = 1.0 + softness;
    float gradient = smoothstep(edge0, edge1, projected);
    if (invert > 0.5) {
        gradient = 1.0 - gradient;
    }

    float mix_amount = clamp(gradient * blurMix, 0.0, 1.0);
    half4 source_color = image.eval(fragCoord);
    half4 blur_color = preblurImage.eval(fragCoord);
    return mix(source_color, blur_color, half(mix_amount));
}
