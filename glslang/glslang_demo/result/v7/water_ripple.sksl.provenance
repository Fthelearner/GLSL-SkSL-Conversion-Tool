{
  "version": 1,
  "metadata": {
    "source_program_kind": "kFragment",
    "shader_stage": "kFragment",
    "glsl_dialect": "kOpenGLCore",
    "glsl_version": 450,
    "runtime_effect_mode": false,
    "use_rt_flip": false,
    "use_fragcoord_workaround": false
  },
  "entries": [
    {
      "kind": "builtin_variable",
      "helper_key": "entry_point_transform",
      "sksl_name": "outColor",
      "glsl_name": "out vec4 fragColor"
    },
    {
      "kind": "builtin_variable",
      "helper_key": "fragcoord_setup",
      "sksl_name": "sk_FragCoord",
      "glsl_name": "gl_FragCoord"
    }
  ]
}
