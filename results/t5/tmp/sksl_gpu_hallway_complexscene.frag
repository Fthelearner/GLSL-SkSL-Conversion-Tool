    if (t = 25.0 - abs(p.r), t < r.r) {
        r = float2(t, 595.0);
    }
    if (t = sdSphere(p - light) - 2.0, t < r.r) {
        r = float2(t, 999.0);
    }
    float2 other = Dist(p);
    if (other.r < r.r) {
        r = other;
    }
    return r;
}

float4 march(float3 p, float3 d) {
    for (int k = 0; k < 100; ++k) {
        float2 t = map(p);
        if (t.r < 0.001) {
            return float4(p, t.g);
        }
        p += d * t.r;
    }
    return float4(0.0, 0.0, 0.0, 0.0);
}

float3 normal(float3 p) {
    float eps = 0.001;
    float2 k = float2(1.0, -1.0);
    return normalize(k.xyy * map(p + k.xyy * eps).r + k.yyx * map(p + k.yyx * eps).r + k.yxy * map(p + k.yxy * eps).r + k.xxx * map(p + k.xxx * eps).r);
}

