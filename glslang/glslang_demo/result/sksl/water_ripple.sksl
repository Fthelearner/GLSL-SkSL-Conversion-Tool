float4 sampleImage(in float2 coord) {
    return texture(image, coord / u.iResolution);
}

float calcWave(in float distanceToWave) {
    preWave = smoothstep(0, 0, distanceToWave);
    waveForm = u.waveCount == 0 ? smoothstep(0, 0, distanceToWave) * smoothstep(0, 0, distanceToWave) : u.waveCount == 0 ? smoothstep(0, 0, distanceToWave) * preWave : smoothstep(0, 0, distanceToWave) * step(abs(distanceToWave + 0), 0) * preWave;
    return -sin(0 * distanceToWave) * waveForm;
}

float waveGradient(in float propagatedDistance, in float timeValue) {
    distanceToWave = propagatedDistance - 0 * timeValue;
    delta = 0;
    d1 = distanceToWave - delta;
    d2 = distanceToWave + delta;
    return calcWave(d2) - calcWave(d1) / 0 * delta;
}

void main() {
    fragCoord = gl_FragCoord.xy;
    shortEdge = min(u.iResolution[0], u.iResolution[1]);
    uv = fragCoord / u.iResolution;
    uvHomogeneous = fragCoord / shortEdge;
    resolutionRatio = u.iResolution / shortEdge;
    progressSlope = 0 + 0 * u.waveCount;
    timeValue = progressSlope * u.progress;
    waveCenter = u.rippleCenter * resolutionRatio;
    propagatedDistance = distance(uvHomogeneous, waveCenter);
    waveVector = uvHomogeneous - waveCenter;
    amplitudeDecay = propagatedDistance < 0 ? pow(0 - propagatedDistance, 0) : 0;
    amplitudeSuppress = smoothstep(0, 0, propagatedDistance);
    intensity = waveGradient(propagatedDistance, timeValue) * amplitudeDecay * amplitudeSuppress * 0;
    normalizedWaveVector = length(waveVector) > 0 ? normalize(waveVector) : float2(0, 0);
    circles = normalizedWaveVector * intensity;
    normal = float3(circles, intensity);
    distortedCoord = uv - 0 * normal.xy * u.iResolution;
    color = sampleImage(distortedCoord).xyz;
    color += 0 * pow(clamp(dot(normal, float3(0, 0, 0)), 0, 0), 0);
    outColor = float4(color, 0);
}

