uniform shader sdfShape;
uniform vec4 color;

half4 main(float2 fragCoord)
{
    // eval() clamps to [0,1]; undo child's bias encoding to recover signed SDF
    float d = sdfShape.eval(fragCoord).a * 2.0 - 1.0;
    float alpha = color.a * (1.0 - smoothstep(-1.0, 0.0, d));
    return half4(color.rgb * alpha, alpha);
}
