uniform float2 iResolution;

half4 main(float2 coord)
{
    float2 center = float2(iResolution.x * 0.5, iResolution.y * 0.45);
    float radius = min(iResolution.x, iResolution.y) * 0.25;
    float d = length(coord - center) - radius;   // signed distance
    // Encode to [0,1]: clamp(d, -1, 1) → mapping  d*0.5+0.5
    return half4(0, 0, 0, half(clamp(d, -1.0, 1.0) * 0.5 + 0.5));
}
