#version 450 core
out vec4 FragColor;
uniform sampler2D srcImageShader;
uniform sampler2D maskImageShader;
uniform vec2 iResolution;
uniform vec4 color0;
uniform vec4 color1;
uniform vec4 color2;
uniform vec4 color3;
uniform vec4 color4;
uniform vec4 color5;
uniform vec4 color6;
uniform vec4 color7;
uniform vec4 color8;
uniform vec4 color9;
uniform vec4 color10;
uniform vec4 color11;
uniform vec2 position0;
uniform vec2 position1;
uniform vec2 position2;
uniform vec2 position3;
uniform vec2 position4;
uniform vec2 position5;
uniform vec2 position6;
uniform vec2 position7;
uniform vec2 position8;
uniform vec2 position9;
uniform vec2 position10;
uniform vec2 position11;
uniform float strength0;
uniform float strength1;
uniform float strength2;
uniform float strength3;
uniform float strength4;
uniform float strength5;
uniform float strength6;
uniform float strength7;
uniform float strength8;
uniform float strength9;
uniform float strength10;
uniform float strength11;
float blendMultipleColorsByDistance_hh2h2h(vec2 uv, vec2 positions, float strength) {
    positions.x *= iResolution.x / iResolution.y;
    vec2 dist = uv - positions;
    float weight = strength / (dot(dist, dist) + 0.0001);
    return weight;
}
void main() {
    vec2 fragCoord = gl_FragCoord.xy;
    vec2 uv = fragCoord / iResolution;
    float screenRatio = iResolution.x / iResolution.y;
    uv.x *= screenRatio;
    float totalWeight = 0.0;
    vec4 blendColor = vec4(0.0);
    vec4 finalColor = vec4(0.0);
    float maskValue = texture(maskImageShader, (fragCoord) / vec2(textureSize(maskImageShader, 0))).w;
    if (maskValue > 0.0) {
        float w0 = blendMultipleColorsByDistance_hh2h2h(uv, position0, strength0);
        totalWeight += w0;
        blendColor += color0 * w0;
        float w1 = blendMultipleColorsByDistance_hh2h2h(uv, position1, strength1);
        totalWeight += w1;
        blendColor += color1 * w1;
        float w2 = blendMultipleColorsByDistance_hh2h2h(uv, position2, strength2);
        totalWeight += w2;
        blendColor += color2 * w2;
        float w3 = blendMultipleColorsByDistance_hh2h2h(uv, position3, strength3);
        totalWeight += w3;
        blendColor += color3 * w3;
        float w4 = blendMultipleColorsByDistance_hh2h2h(uv, position4, strength4);
        totalWeight += w4;
        blendColor += color4 * w4;
        float w5 = blendMultipleColorsByDistance_hh2h2h(uv, position5, strength5);
        totalWeight += w5;
        blendColor += color5 * w5;
        float w6 = blendMultipleColorsByDistance_hh2h2h(uv, position6, strength6);
        totalWeight += w6;
        blendColor += color6 * w6;
        float w7 = blendMultipleColorsByDistance_hh2h2h(uv, position7, strength7);
        totalWeight += w7;
        blendColor += color7 * w7;
        float w8 = blendMultipleColorsByDistance_hh2h2h(uv, position8, strength8);
        totalWeight += w8;
        blendColor += color8 * w8;
        float w9 = blendMultipleColorsByDistance_hh2h2h(uv, position9, strength9);
        totalWeight += w9;
        blendColor += color9 * w9;
        float w10 = blendMultipleColorsByDistance_hh2h2h(uv, position10, strength10);
        totalWeight += w10;
        blendColor += color10 * w10;
        float w11 = blendMultipleColorsByDistance_hh2h2h(uv, position11, strength11);
        totalWeight += w11;
        blendColor += color11 * w11;
        finalColor = blendColor / totalWeight;
        finalColor.w *= maskValue;
    }
    finalColor.xyz = mix(texture(srcImageShader, (fragCoord) / vec2(textureSize(srcImageShader, 0))).xyz, finalColor.xyz, vec3(finalColor.w));
    FragColor = vec4(finalColor.xyz, 1.0);
    return;
}
