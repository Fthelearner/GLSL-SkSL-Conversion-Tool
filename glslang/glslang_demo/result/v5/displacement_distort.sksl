// Generated by GLSL to SkSL Code Generator

// Fragment Shader

layout(binding = 0) uniform sampler2D image;
layout(binding = 1) uniform sampler2D displacementMap;
uniform float2 u_iResolution;
uniform float2 u_factor;
uniform float u_strength;

float4 sampleImage(in float2 coord) {
    return texture(image, coord / u_iResolution);
}

float4 sampleDisplacementMap(in float2 coord) {
    return texture(displacementMap, coord / u_iResolution);
}

half4 main(float2 fragCoord) {
    float4 outColor;
    float2 uv = fragCoord / u_iResolution;
    float4 displacement = sampleDisplacementMap(fragCoord);
    if (displacement[3] <= 0.0) {
        outColor = sampleImage(fragCoord);
    }
    float2 direction = 2.0 * (displacement.xy - 0.5);
    float2 normal = direction * u_factor * u_strength;
    float2 refractedUv = clamp(uv - normal * 0.05, float2(0.001, 0.001), float2(0.999, 0.999));
    outColor = texture(image, refractedUv);
    return half4(outColor);
}


