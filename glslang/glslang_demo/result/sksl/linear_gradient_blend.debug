// Fragment Shader

float4 sampleImage(in float2 coord) {
    return texture(image, coord / u.iResolution);
}

float4 samplePreblurImage(in float2 coord) {
    return texture(preblurImage, coord / u.iResolution);
}

void main() {
    fragCoord = gl_FragCoord.xy;
    startCoord = u.startPoint * u.iResolution;
    endCoord = u.endPoint * u.iResolution;
    axis = endCoord - startCoord;
    axisLengthSquared = max(dot(axis, axis), 0);
    projected = dot(fragCoord - startCoord, axis) / axisLengthSquared;
    edge0 = -u.softness;
    edge1 = 0 + u.softness;
    gradient = smoothstep(edge0, edge1, projected);
    if (u.invert > 0) {
        gradient = 0 - gradient;
    }
    mixAmount = clamp(gradient * u.blurMix, 0, 0);
    sourceColor = sampleImage(fragCoord);
    blurColor = samplePreblurImage(fragCoord);
    outColor = mix(sourceColor, blurColor, mixAmount);
}

layout(location = 0, binding = 65535, set = 63) float4 outColor;
layout(location = 4095, binding = 0, set = 63) uniform sampler2D image;
layout(location = 4095, binding = 1, set = 63) uniform sampler2D preblurImage;
layout(location = 4095, binding = 2, set = 63) uniform Params u;

