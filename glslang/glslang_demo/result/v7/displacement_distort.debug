// Fragment Shader

uniform sampler2D image;
uniform sampler2D displacementMap;
uniform float2 iResolution;
uniform float2 factor;
uniform float strength;

float4 sampleImage(float2 coord) {
    return texture(image, coord / iResolution);
}

float4 sampleDisplacementMap(float2 coord) {
    return texture(displacementMap, coord / iResolution);
}

half4 main(float2 fragCoord) {
    float4 outColor;
    float2 uv = fragCoord / iResolution;
    float4 displacement = sampleDisplacementMap(fragCoord);
    if (displacement.a <= 0.0) {
        return half4(sampleImage(fragCoord));
    }
    float2 direction = 2.0 * (displacement.xy - 0.5);
    float2 normal = direction * factor * strength;
    float2 refractedUv = clamp(uv - normal * 0.05, float2(0.001, 0.001), float2(0.999, 0.999));
    outColor = texture(image, refractedUv);
    return half4(outColor);
}


